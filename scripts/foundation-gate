#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
VENV="$ROOT/.work/venv"
EVIDENCE="$ROOT/evidence/foundation"

BARESIP=
LIBRE=
while [ "$#" -gt 0 ]; do
	case "$1" in
		--baresip)
			BARESIP=$2
			shift 2
			;;
		--libre)
			LIBRE=$2
			shift 2
			;;
		*)
			echo "unknown argument: $1" >&2
			exit 2
			;;
	esac
done

if [ -z "$BARESIP" ] || [ -z "$LIBRE" ]; then
	echo "usage: $0 --baresip PATH --libre PATH" >&2
	exit 2
fi

echo "note: foundation-gate is retired as a product release gate;" >&2
echo "running harness oracle and supervision calibration only" >&2
python3 -m venv "$VENV"
"$VENV/bin/python" -m pip install --disable-pip-version-check -e "$ROOT[test]"
"$VENV/bin/python" -m pytest "$ROOT/tests"
"$VENV/bin/dc-acceptance" \
	--baresip "$BARESIP" \
	--libre "$LIBRE" \
	--evidence "$EVIDENCE"
